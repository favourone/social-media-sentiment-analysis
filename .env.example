# Generate a long random value before deployment, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false

# Local development can use inline. Docker Compose overrides this to rq.
TASK_QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=sentiment-jobs
MONITOR_SCHEDULER_SECONDS=30

RUNTIME_DIR=runtime
PRODUCT_DB_PATH=runtime/sentiment.db
REPORT_DIR=runtime/reports
IMPORT_DIR=runtime/imports
MAX_UPLOAD_BYTES=10485760

WEB_PORT=5000
WEB_DEBUG=false
CORS_ORIGINS=
MONGO_ENABLED=false

# V2 monitoring: outbound RSS feeds and webhooks block local/private networks
# by default. Only enable private targets on a trusted isolated network.
RSS_TIMEOUT_SECONDS=15
RSS_MAX_BYTES=2097152
ALLOW_PRIVATE_NETWORK_URLS=false
WEBHOOK_TIMEOUT_SECONDS=10

# Optional OpenAI-compatible endpoint. Core monitoring works without an LLM.
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# External MediaCrawler integration (non-commercial learning/research only).
# The repository is intentionally not vendored into this project.
MEDIACRAWLER_HOME=external/MediaCrawler
MEDIACRAWLER_OUTPUT_DIR=external/MediaCrawler/data
MEDIACRAWLER_TIMEOUT_SECONDS=1800
COLLECTOR_LICENSE_ACCEPTED=false
# MediaCrawler reads keywords from its config. The adapter applies a narrow,
# temporary override and restores that file after every job.
MEDIACRAWLER_COMMAND_JSON=["uv","run","main.py","--platform","wb","--lt","qrcode","--type","search"]
