# 部署前请生成一个足够长的随机密钥，例如：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false

# 本地开发可以使用 inline（full/hybrid 分析由单进程后台线程执行）；
# Docker Compose 会将其覆盖为 rq，重启后需要恢复任务时也应使用 rq。
TASK_QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=sentiment-jobs
MONITOR_SCHEDULER_SECONDS=30

RUNTIME_DIR=runtime
PRODUCT_DB_PATH=runtime/sentiment.db
REPORT_DIR=runtime/reports
IMPORT_DIR=runtime/imports
MAX_UPLOAD_BYTES=10485760

WEB_PORT=5000
WEB_DEBUG=false
CORS_ORIGINS=
MONGO_ENABLED=false

# V2 监测默认禁止 RSS 和 Webhook 访问本机或私有网络。
# 只有在可信且隔离的网络中才允许启用私有地址。
RSS_TIMEOUT_SECONDS=15
RSS_MAX_BYTES=2097152
ALLOW_PRIVATE_NETWORK_URLS=false
WEBHOOK_TIMEOUT_SECONDS=10

# 可选的 OpenAI 兼容接口；不开启大模型也能使用核心监测功能。
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# 外部 MediaCrawler 集成，仅限非商业学习和研究用途。
# 本项目不会复制或内置该第三方仓库。
MEDIACRAWLER_HOME=external/MediaCrawler
MEDIACRAWLER_OUTPUT_DIR=external/MediaCrawler/data
MEDIACRAWLER_TIMEOUT_SECONDS=1800
COLLECTOR_LICENSE_ACCEPTED=false
# MediaCrawler 从自身配置读取关键词；适配器只会进行范围受限的临时修改，
# 并在每个任务结束后恢复原配置文件。
MEDIACRAWLER_COMMAND_JSON=["uv","run","main.py","--platform","wb","--lt","qrcode","--type","search"]

# ==================== 算法升级 V3（suanfa 分支） ====================
# 情感分析：auto=存在微调检查点时优先 BERT，否则回退词典；bert=强制 BERT；lexicon=只用词典。
# 微调训练：python scripts/finetune_bert_sentiment.py --train <数据文件>
SENTIMENT_ENGINE=auto
SENTIMENT_BERT_MODEL_DIR=models/saved/bert_sentiment
SENTIMENT_BERT_MAX_LENGTH=128

# 事件聚类：auto=信号足够时用 BERTopic，依赖不可用或信号过少时自动回退 n-gram；ngram=固定基线。
# 需要 pip install -r requirements-ml.txt；首次使用会下载多语言句向量模型。
CLUSTERING_ENGINE=auto
BERTOPIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
BERTOPIC_MIN_TOPIC_SIZE=3
BERTOPIC_MIN_DOCS=8
BERTOPIC_RANDOM_STATE=42

# 混合趋势预测（ARIMA/SIR 基线 + LSTM 讨论量预测 + SIR 形状先验）
HYBRID_FORECAST_DAYS=7
HYBRID_HIDDEN_SIZE=24
HYBRID_EPOCHS=300
HYBRID_SIR_PRIOR_WEIGHT=0.15
